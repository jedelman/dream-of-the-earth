{
  "lexicon": 1,
  "id": "org.jason-edelman.dream.intent",
  "description": "A Dream of the Earth player's current intent: what their creature is doing, from which every mutual computes where it is. One record (rkey 'self'), overwritten; deleted when they leave. Stale after 10 minutes without renewal.",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["kind", "at", "latE6", "lonE6", "altDm", "creature"],
        "properties": {
          "world": { "type": "string", "format": "uri", "const": "https://dream-of-the-earth.jason-edelman.org/" },
          "kind": { "type": "string", "knownValues": ["rest", "goto", "ride", "steer"] },
          "at": { "type": "string", "format": "datetime", "description": "When this intent starts." },
          "latE6": { "type": "integer", "minimum": -90000000, "maximum": 90000000 },
          "lonE6": { "type": "integer", "minimum": -180000000, "maximum": 180000000 },
          "altDm": { "type": "integer", "description": "Decimetres above sea level." },
          "creature": { "type": "object", "required": ["seed", "stats"], "properties": { "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "stats": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 9 }, "minLength": 4, "maxLength": 6, "description": "climb, swim, run, gleam, perception, fly (total at most 12; each at most 6, or up to 9 where the player's rhizome raised its ceiling). Five values are read with no fly; four (from before 11-09: fly, swim, run, gleam) as climb, swim, run, gleam with no perception." }, "genes": { "type": "object", "description": "Optional changes the player made in the editor; without them the creature is exactly what its seed makes. Out-of-range or unknown fields are ignored.", "properties": { "roll": { "type": "object", "description": "A re-roll seed per trait, each 0..4294967295.", "properties": { "palette": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "body": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "heads": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "eyes": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "wings": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "legs": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "tail": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "spikes": { "type": "integer", "minimum": 0, "maximum": 4294967295 } } }, "count": { "type": "object", "description": "How many of each part (wings and legs in pairs).", "properties": { "heads": { "type": "integer", "minimum": 0, "maximum": 3 }, "eyes": { "type": "integer", "minimum": 0, "maximum": 9 }, "wings": { "type": "integer", "minimum": 0, "maximum": 4 }, "legs": { "type": "integer", "minimum": 0, "maximum": 4 }, "tail": { "type": "integer", "minimum": 0, "maximum": 4 }, "spikes": { "type": "integer", "minimum": 0, "maximum": 10 } } }, "hue": { "type": "integer", "minimum": 1, "maximum": 359, "description": "Degrees to turn the palette round the colour wheel." }, "size": { "type": "integer", "minimum": 80, "maximum": 160, "description": "Size, as a percentage." } } }, "looks": { "type": "array", "maxLength": 3, "items": { "type": "string", "knownValues": ["halo", "motes", "sheen"] }, "description": "Looks the player's rhizome has woken; each phone builds them." }, "worn": { "type": "array", "maxLength": 2, "items": { "type": "string", "knownValues": ["prism", "tidefin", "mossfoot", "owleye"] }, "description": "What the creature wears (at most two things), by name; each phone builds the look itself. Unknown names are ignored." } } },
          "goto": { "type": "object", "properties": { "pts": { "type": "array", "maxLength": 64, "items": { "type": "array", "items": { "type": "integer" }, "minLength": 2, "maxLength": 2 } }, "speedCm": { "type": "integer" }, "fly": { "type": "boolean" }, "cruiseDm": { "type": "integer" } } },
          "ride": { "type": "object", "properties": { "line": { "type": "integer" }, "tE6": { "type": "integer", "minimum": 0, "maximum": 1000000 }, "dir": { "type": "integer", "enum": [-1, 1] } } },
          "steer": { "type": "object", "properties": { "headingMdeg": { "type": "integer", "minimum": 0, "maximum": 360000 }, "speedCm": { "type": "integer" }, "climbCm": { "type": "integer" } } }
        }
      }
    }
  }
}
