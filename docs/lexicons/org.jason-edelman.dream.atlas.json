{
  "lexicon": 1,
  "id": "org.jason-edelman.dream.atlas",
  "description": "A Dream of the Earth player's atlas: the places they've found, to travel back to. One record (rkey 'self'), overwritten as it grows, so it follows them to any device; devices merge.",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "shrines",
          "updatedAt"
        ],
        "properties": {
          "shrines": {
            "type": "array",
            "maxLength": 2000,
            "description": "Shrines found, earliest first.",
            "items": {
              "type": "object",
              "required": [
                "key",
                "latE6",
                "lonE6",
                "spell",
                "at"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "maxLength": 16,
                  "description": "The shrine's key: 'shrine' and its cell's hash."
                },
                "latE6": {
                  "type": "integer",
                  "minimum": -90000000,
                  "maximum": 90000000
                },
                "lonE6": {
                  "type": "integer",
                  "minimum": -180000000,
                  "maximum": 180000000
                },
                "spell": {
                  "type": "string",
                  "knownValues": [
                    "giant",
                    "tiny",
                    "taffy",
                    "mask",
                    "upturned",
                    "fisheye",
                    "turning",
                    "colours",
                    "kaleido",
                    "melt",
                    "days"
                  ]
                },
                "at": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "When it was first found (seconds since 1970)."
                }
              }
            }
          },
          "nodes": { "type": "array", "maxLength": 2000, "description": "Ley nodes you've been to (within 2 km, or arrived at on a highway), by their index in the network, earliest first.", "items": { "type": "object", "required": ["i", "at"], "properties": { "i": { "type": "integer", "minimum": 0 }, "at": { "type": "integer", "minimum": 0 } } } },
          "landmarks": { "type": "array", "maxLength": 2000, "description": "Landmarks you've been to (within 3 km), by name, earliest first.", "items": { "type": "object", "required": ["name", "at"], "properties": { "name": { "type": "string", "maxLength": 120 }, "at": { "type": "integer", "minimum": 0 } } } },
          "ways": { "type": "array", "maxLength": 2000, "description": "River waymarks you've read, by key: the basin's key and the waymark's number from the sea ('seine-river:2'), earliest first.", "items": { "type": "object", "required": ["key", "at"], "properties": { "key": { "type": "string", "maxLength": 68 }, "at": { "type": "integer", "minimum": 0 } } } },
          "springs": { "type": "array", "maxLength": 2000, "description": "Rivers' springs (headwaters shrines) you've drunk from, by basin key, earliest first: each a spring stone of that river.", "items": { "type": "object", "required": ["key", "at"], "properties": { "key": { "type": "string", "maxLength": 64 }, "at": { "type": "integer", "minimum": 0 } } } },
          "seen": { "type": "array", "maxLength": 10000, "description": "Where you've stood: cells of a quarter degree (row from the north times 1440, plus column from 180° W; 0 to 1036799), earliest first. The atlas's map clears its clouds round them.", "items": { "type": "integer", "minimum": 0, "maximum": 1036799 } },
          "basins": { "type": "array", "maxLength": 2000, "description": "River basins you know (you've been in), by key (the basin's name, lower case and hyphenated: 'amazon-river', 'lake-chad'), earliest first.", "items": { "type": "object", "required": ["key", "at"], "properties": { "key": { "type": "string", "maxLength": 64 }, "at": { "type": "integer", "minimum": 0 } } } },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
